# Configuración de Base de Datos
DATABASE_URL=mysql+pymysql://barber_user:barber_password@127.0.0.1:3306/barberia_db

# Para entorno de desarrollo local con SQLite (opcional y sin dependencias externas):
# DATABASE_URL=sqlite:///./barberia.db

# Configuración de Servidor y Seguridad
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
SECRET_KEY=cambiar_esta_clave_secreta_en_produccion

# Enlace de recuperación de contraseña (RF-04): dirección donde corre el frontend
FRONTEND_URL=http://localhost:5173

# Correo saliente (RF-04, RF-07, RF-21, RF-25). Si SMTP_HOST se deja vacío, los correos no se envían:
# su contenido se escribe en el registro del servidor (útil en desarrollo).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Datos iniciales (python seed.py). Si no se definen las contraseñas, el seed genera unas aleatorias
# y las muestra una sola vez en consola.
SEED_ADMIN_EMAIL=admin@barbershop.pro
SEED_ADMIN_PASSWORD=
SEED_BARBEROS_PASSWORD=
